# Global blacklist: ignore everything, except directories.
*
!*/

# Per-directory whitelists.

# root
!/.gitignore
!/LICENSE
!/README.md
!/AGENTS.md
!/CODEBASE_MAP.md
!/build.gradle.kts
!/settings.gradle.kts
!/gradle.properties
!/gradlew

# gradle wrapper
!/gradle/wrapper/gradle-wrapper.jar
!/gradle/wrapper/gradle-wrapper.properties

# app module
!/app/build.gradle.kts
!/app/src/main/AndroidManifest.xml

# python wheels
!/app/libs/*.whl

# android resources
!/app/src/main/res/**/*.xml

# kotlin source
!/app/src/main/java/**/*.kt
!/app/src/test/java/**/*.kt
!/app/src/androidTest/java/**/*.kt

# fdroid metadata
!/metadata/**/*.yml
!/srclibs/CPython.yml

# fastlane metadata
!/fastlane/metadata/**/*.jpg
!/fastlane/metadata/**/*.png
!/fastlane/metadata/**/*.txt

# github actions
!/.github/workflows/ci.yml
!/.github/workflows/release.yml
